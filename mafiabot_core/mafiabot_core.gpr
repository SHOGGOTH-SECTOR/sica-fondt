with "config/mafiabot_core_config.gpr";

project Mafiabot_Core is

   for Source_Dirs use
     ("src",
      "src/core",
      "src/daemons",
      "src/network",
      "src/payloads",
      "config",
      "tests");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   for Main use ("mafiabot.adb", "engine_tests.adb");

   package Builder is
      for Global_Configuration_Pragmas use "gnat.adc";
   end Builder;

end Mafiabot_Core;
