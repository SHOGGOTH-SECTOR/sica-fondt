{
  "permissions": {
    "allow": [
      "Bash(command -v *)",
      "Bash(ponyc --version)",
      "Bash(alr --version)",
      "Bash(cobc --version)",
      "Bash(gnatmake --version)",
      "Bash(gprbuild --version)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/install-toolchains.sh"
          }
        ]
      }
    ]
  }
}
